# Database — MongoDB Atlas (replica set, required for transactions). Check with: npm run db:check
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/wealthtrack?retryWrites=true&w=majority
# Optional local alternative (docker compose up -d):
# MONGODB_URI=mongodb://localhost:27017/wealthtrack?replicaSet=rs0&directConnection=true

# Auth (Better Auth)
# At least 32 characters. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000
# Set to true after creating your account to close registration
DISABLE_SIGNUP=false

# App
APP_URL=http://localhost:3000
DEFAULT_TIMEZONE=Asia/Colombo
DEFAULT_CURRENCY=LKR

# Cron (Authorization: Bearer <CRON_SECRET>), at least 16 characters
CRON_SECRET=change-me-to-a-random-string

# Email reminders (optional)
RESEND_API_KEY=
MAIL_FROM=WealthTrack <reminders@example.com>

# File storage for receipts: local | s3
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./.uploads
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
